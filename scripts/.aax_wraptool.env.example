# Copy to .aax_wraptool.env and fill in (that file is gitignored).
# wraptool_sign_aax.sh sources .aax_wraptool.env on macOS if it exists.
#
# CI: set the same variable names as encrypted secrets instead of using this file.

export AAX_WRAPTOOL_ACCOUNT=""
export AAX_WRAPTOOL_PASSWORD=""
export AAX_WRAPTOOL_SIGNID=""
# Publisher (one path): Fusion wrap config GUID, or PACE customer number + company name.
# AAX_WRAPTOOL_WCGUID = wrap config GUID (PACE server must have wrapper data — see Fusion wrap/wrapper UI).
#   Not the same as "Product GUID" in the catalog; wrong GUID → WrapConfigNotFound from wraptool.
# export AAX_WRAPTOOL_WCGUID=""
# export AAX_WRAPTOOL_CUSTOMERNUMBER=""
# export AAX_WRAPTOOL_CUSTOMERNAME=""
# If wraptool says CouldNotFindSignerCredentials:
#   • PACE: --allowsigningservice is used only when **no signing iLok is plugged in** — unplug USB
#     iLok to force cloud signing (needs ALLOW_SIGNING_SERVICE=1 + network + account/password).
#   • Or keep iLok plugged in but install publisher **signing** credential on it, then Synchronize.
# export AAX_WRAPTOOL_ALLOW_SIGNING_SERVICE=1
# Optional: official AnalyzerPro wrap line uses --autoinstall on → export AAX_WRAPTOOL_AUTOINSTALL=on
# export AAX_WRAPTOOL="/Applications/PACEAntiPiracy/Eden/Fusion/Current/bin/wraptool"
