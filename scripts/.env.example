# Local developer env (copy this file to scripts/.env — gitignored).
# Sourced by: scripts/source_repo_env.sh → build.sh, build_release.sh, release_macos.sh
# A JUCE_PATH you export in the shell before running a script overrides .env.

# JUCE framework root (required for CMake). Example for this machine’s layout:
# JUCE_PATH=/Users/avishaylidani/DEV/SDK/JUCE
JUCE_PATH=/path/to/JUCE

# Figma Personal Access Token
# Get yours from: https://www.figma.com/settings (Personal Access Tokens section)
FIGMA_TOKEN=your_figma_token_here

# Optional: Override Figma file ID (can also be set in figma-export.config.json)
# FIGMA_FILE_ID=your_file_id_here
