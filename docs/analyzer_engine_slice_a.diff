+void AnalyzerEngine::updateBallisticsRates()
+{
+    const double hopSec = static_cast<double> (currentHopSize) / currentSampleRate;
+    if (hopSec <= 0.0)
+        return;
+    const double rateForHop = 1.0 / hopSec;
+
+    for (size_t i = 0; i < rmsBallistics_.size(); ++i)
+        rmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                rmsBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < peakBallistics_.size(); ++i)
+        peakBallistics_[i].reset (rateForHop, static_cast<double> (peakAttackMs_), static_cast<double> (peakReleaseMs_),
+                                 peakBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < lRmsBallistics_.size(); ++i)
+        lRmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                 lRmsBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < rRmsBallistics_.size(); ++i)
+        rRmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                 rRmsBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < midRmsBallistics_.size(); ++i)
+        midRmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                  midRmsBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < sideRmsBallistics_.size(); ++i)
+        sideRmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                   sideRmsBallistics_[i].getCurrentLevel());
+    for (size_t i = 0; i < monoRmsBallistics_.size(); ++i)
+        monoRmsBallistics_[i].reset (rateForHop, static_cast<double> (rmsAttackMs_), static_cast<double> (rmsReleaseMs_),
+                                    monoRmsBallistics_[i].getCurrentLevel());
+}
